# Copy to .env next to docker-compose.yml and fill in. .env is gitignored.
#
# In local development that means the repository root. On the deploy server it
# lives in /opt/financeai/ instead — never in the runner's workspace, which
# actions/checkout wipes on every deploy. See README > Despliegue.
#
# Leave SPRING_PROFILES_ACTIVE=dev to keep the in-memory database, or set it to
# "oracle" to persist in Oracle Autonomous Database.
SPRING_PROFILES_ACTIVE=dev

# Signing key for the session tokens. Required: the backend refuses to start
# without it, on any profile. Generate a fresh one per environment with
#
#     openssl rand -hex 32
#
# Anyone holding this value can mint a valid token for any account, so it never
# goes in the repository and staging never shares it with production. Changing it
# invalidates every token already issued, which logs everyone out — that is the
# correct move if you suspect it leaked.
JWT_SECRET=

# TNS alias from the wallet's tnsnames.ora. For an ATP instance named fintech
# the transaction-processing service is fintech_tp. TNS_ADMIN must point at the
# wallet directory mounted into the container (/app/wallet).
ORACLE_JDBC_URL=jdbc:oracle:thin:@fintech_tp?TNS_ADMIN=/app/wallet

# Application schema user — not ADMIN.
ORACLE_DB_USER=FINTECH_APP
ORACLE_DB_PASSWORD=
