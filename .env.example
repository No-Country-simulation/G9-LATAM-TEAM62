# Copy to .env next to docker-compose.yml and fill in. .env is gitignored.
#
# In local development that means the repository root. On the deploy server it
# lives in /opt/financeai/ instead — never in the runner's workspace, which
# actions/checkout wipes on every deploy. See README > Despliegue.
#
# Leave SPRING_PROFILES_ACTIVE=dev to keep the in-memory database, or set it to
# "oracle" to persist in Oracle Autonomous Database.
SPRING_PROFILES_ACTIVE=dev

# TNS alias from the wallet's tnsnames.ora. For an ATP instance named financeai
# the transaction-processing service is financeai_tp. TNS_ADMIN must point at the
# wallet directory mounted into the container (/app/wallet).
ORACLE_JDBC_URL=jdbc:oracle:thin:@financeai_tp?TNS_ADMIN=/app/wallet

# Application schema user — not ADMIN.
ORACLE_DB_USER=FINTECH_APP
ORACLE_DB_PASSWORD=
